{
    "name": "@domain-first/handlers-next",
    "description": "Next Adapters for @domain-first/handlers and App router endpoints",
    "version": "1.0.1",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "keywords": [
        "next",
        "nextjs",
        "adapter",
        "domain-first"
    ],
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/alevnyacow/domain-first-handlers-next.git"
    },
    "scripts": {
        "build": "rslib",
        "check": "biome check --write",
        "dev": "rslib --watch",
        "format": "biome format --write",
        "test": "rstest",
        "test:watch": "rstest --watch"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.15",
        "@domain-first/handlers-rest": "^5.1.0",
        "@rslib/core": "^0.23.2",
        "@rstest/adapter-rslib": "^0.10.6",
        "@rstest/core": "^0.10.6",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/npm": "^13.1.5",
        "@types/node": "^24.13.2",
        "next": "^16.3.3",
        "semantic-release": "^25.0.9",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "next": ">=13 <17"
    }
}
